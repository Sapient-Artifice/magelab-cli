{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magelab.ai/schemas/websocket/protocol.json",
  "title": "MageLab WebSocket Protocol",
  "description": "Message types for communication between clients (CLI, Pi extension) and the MageLab Python backend over WebSocket.",

  "$defs": {
    "ClientMessage": {
      "description": "Messages sent from client to backend",
      "oneOf": [
        { "$ref": "#/$defs/TextMessage" },
        { "$ref": "#/$defs/AudioMessage" },
        { "$ref": "#/$defs/GetRuntimeConfig" },
        { "$ref": "#/$defs/GetTools" },
        { "$ref": "#/$defs/ToolCallRequest" },
        { "$ref": "#/$defs/ConfirmationResponse" },
        { "$ref": "#/$defs/SetModel" },
        { "$ref": "#/$defs/SetVoice" },
        { "$ref": "#/$defs/GetModels" },
        { "$ref": "#/$defs/NewChat" },
        { "$ref": "#/$defs/GetChats" },
        { "$ref": "#/$defs/SetChat" },
        { "$ref": "#/$defs/WriteRuntimeState" },
        { "$ref": "#/$defs/Control" },
        { "$ref": "#/$defs/Lifecycle" },
        { "$ref": "#/$defs/CancelSubagent" },
        { "$ref": "#/$defs/VaultGetResponse" },
        { "$ref": "#/$defs/ShellSessionInput" },
        { "$ref": "#/$defs/McpInstallPermissionResponse" },
        { "$ref": "#/$defs/ClipboardResponse" },
        { "$ref": "#/$defs/NotificationResponse" },
        { "$ref": "#/$defs/ScreenshotResponse" }
      ]
    },

    "ServerMessage": {
      "description": "Messages sent from backend to client",
      "oneOf": [
        { "$ref": "#/$defs/AssistantStream" },
        { "$ref": "#/$defs/Assistant" },
        { "$ref": "#/$defs/AssistantComplete" },
        { "$ref": "#/$defs/Transcription" },
        { "$ref": "#/$defs/ConfirmationRequest" },
        { "$ref": "#/$defs/ToolResult" },
        { "$ref": "#/$defs/ToolDebug" },
        { "$ref": "#/$defs/RuntimeConfig" },
        { "$ref": "#/$defs/ToolsList" },
        { "$ref": "#/$defs/ToolCallResult" },
        { "$ref": "#/$defs/SetModelResult" },
        { "$ref": "#/$defs/ModelsResult" },
        { "$ref": "#/$defs/NewChatResult" },
        { "$ref": "#/$defs/ChatListResult" },
        { "$ref": "#/$defs/ChatSwitchResult" },
        { "$ref": "#/$defs/RuntimeStateWriteResult" },
        { "$ref": "#/$defs/RequestError" },
        { "$ref": "#/$defs/TokenCount" },
        { "$ref": "#/$defs/SubagentUpdate" },
        { "$ref": "#/$defs/SubagentComplete" },
        { "$ref": "#/$defs/Notify" },
        { "$ref": "#/$defs/OpenUrl" },
        { "$ref": "#/$defs/OpenFile" },
        { "$ref": "#/$defs/BrokerStatus" },
        { "$ref": "#/$defs/BindResult" },
        { "$ref": "#/$defs/BrokerError" },
        { "$ref": "#/$defs/ErrorMessage" },
        { "$ref": "#/$defs/Ping" },
        { "$ref": "#/$defs/VaultGetPrompt" },
        { "$ref": "#/$defs/SetVoiceResult" },
        { "$ref": "#/$defs/TtsAudio" },
        { "$ref": "#/$defs/ConfirmationResolved" },
        { "$ref": "#/$defs/ModelSuggestion" },
        { "$ref": "#/$defs/McpServerStatus" },
        { "$ref": "#/$defs/McpInstallPermission" },
        { "$ref": "#/$defs/ClipboardRequest" },
        { "$ref": "#/$defs/NotificationRequest" },
        { "$ref": "#/$defs/ScreenshotRequest" },
        { "$ref": "#/$defs/ShellSession" },
        { "$ref": "#/$defs/ShellSessionInputResult" }
      ]
    },

    "TextMessage": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "client_request_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },

    "AudioMessage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "audio" }
      },
      "additionalProperties": true
    },

    "GetRuntimeConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "get_runtime_config" }
      },
      "additionalProperties": false
    },

    "GetTools": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "get_tools" }
      },
      "additionalProperties": false
    },

    "ToolCallRequest": {
      "type": "object",
      "required": ["type", "call_id", "function_name"],
      "properties": {
        "type": { "const": "tool_call" },
        "call_id": { "type": "string", "description": "Client-generated UUID for response correlation" },
        "function_name": { "type": "string" },
        "arguments": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "ConfirmationResponse": {
      "type": "object",
      "required": ["type", "confirmation_id", "confirmed", "remember"],
      "properties": {
        "type": { "const": "confirmation_response" },
        "confirmation_id": { "type": "string" },
        "confirmed": { "type": "boolean" },
        "remember": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "SetModel": {
      "type": "object",
      "required": ["type", "model"],
      "properties": {
        "type": { "const": "set_model" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },

    "SetVoice": {
      "type": "object",
      "required": ["type", "voice"],
      "properties": {
        "type": { "const": "set_voice" },
        "voice": { "type": "string" }
      },
      "additionalProperties": false
    },

    "GetModels": {
      "type": "object",
      "required": ["type", "endpoint", "api_key"],
      "properties": {
        "type": { "const": "get_models" },
        "endpoint": { "type": "string" },
        "api_key": { "type": "string" }
      },
      "additionalProperties": false
    },

    "NewChat": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "new_chat" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },

    "GetChats": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "get_chats" }
      },
      "additionalProperties": false
    },

    "SetChat": {
      "type": "object",
      "required": ["type", "chat_id"],
      "properties": {
        "type": { "const": "set_chat" },
        "chat_id": { "type": "integer" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },

    "WriteRuntimeState": {
      "type": "object",
      "required": ["type", "state"],
      "properties": {
        "type": { "const": "write_runtime_state" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "state": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "Control": {
      "type": "object",
      "required": ["type", "action"],
      "properties": {
        "type": { "const": "control" },
        "action": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Lifecycle": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "lifecycle" },
        "action": { "type": "string" }
      },
      "additionalProperties": true
    },

    "CancelSubagent": {
      "type": "object",
      "required": ["type", "task_id"],
      "properties": {
        "type": { "const": "cancel_subagent" },
        "task_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "AssistantStream": {
      "type": "object",
      "required": ["type", "phase"],
      "properties": {
        "type": { "const": "assistant_stream" },
        "phase": { "type": "string", "enum": ["start", "delta", "end"] },
        "token": { "type": "string" },
        "text": { "type": "string" },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "stream_id": { "type": "string" },
        "client_request_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Assistant": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "assistant" },
        "text": { "type": "string" },
        "reasoning": { "type": "string" },
        "client_request_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "AssistantComplete": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "assistant_complete" },
        "client_request_id": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "cancelled", "error"] },
        "code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Transcription": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "transcription" },
        "text": { "type": "string" },
        "client_request_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ConfirmationRequest": {
      "type": "object",
      "required": ["type", "confirmation_id", "function_name"],
      "properties": {
        "type": { "const": "confirmation_request" },
        "confirmation_id": { "type": "string" },
        "function_name": { "type": "string" },
        "script": { "type": "string" },
        "arguments": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "ToolResult": {
      "type": "object",
      "required": ["type", "function_name"],
      "properties": {
        "type": { "const": "tool_result" },
        "function_name": { "type": "string" },
        "result": {}
      },
      "additionalProperties": false
    },

    "ToolDebug": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "tool_debug" },
        "message_type": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },

    "RuntimeConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "runtime_config" },
        "llm_provider_name": { "type": "string" },
        "llm_endpoint": { "type": "string" },
        "llm_model_name": { "type": "string" },
        "voice_model": { "type": "string" },
        "tts_stream": { "type": "boolean" },
        "mute": { "type": "boolean" },
        "history_path": { "type": "string" },
        "list_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },

    "ToolsList": {
      "type": "object",
      "required": ["type", "tools"],
      "properties": {
        "type": { "const": "tools_list" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "const": "function" },
              "function": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "parameters": { "type": "object" }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },

    "ToolCallResult": {
      "type": "object",
      "required": ["type", "call_id", "success"],
      "properties": {
        "type": { "const": "tool_call_result" },
        "call_id": { "type": "string" },
        "success": { "type": "boolean" },
        "result": {},
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "SetModelResult": {
      "type": "object",
      "required": ["type", "success"],
      "properties": {
        "type": { "const": "set_model_result" },
        "success": { "type": "boolean" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ModelsResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "models_result" },
        "models": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "NewChatResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "new_chat_result" },
        "history_path": { "type": "string" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "chat_id": { "type": "integer" },
        "chat_records": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ChatListResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "chat_list_result" },
        "ok": { "type": "boolean" },
        "history_path": { "type": "string" },
        "chats": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "ChatSwitchResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "chat_switch_result" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "chat_id": { "type": "integer" },
        "chat_records": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "history_path": { "type": "string" },
        "code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "RuntimeStateWriteResult": {
      "type": "object",
      "required": ["type", "ok"],
      "properties": {
        "type": { "const": "runtime_state_write_result" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "applied": { "type": "object", "additionalProperties": true },
        "snapshot": { "type": "object", "additionalProperties": true },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "RequestError": {
      "type": "object",
      "required": ["type", "ok", "code", "error"],
      "properties": {
        "type": { "const": "request_error" },
        "ok": { "type": "boolean" },
        "code": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "TokenCount": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "token_count" },
        "sys_count": { "type": "integer" },
        "win_count": { "type": "integer" },
        "total_count": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "SubagentUpdate": {
      "type": "object",
      "required": ["type", "task_id", "name"],
      "properties": {
        "type": { "const": "subagent_update" },
        "task_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "string" },
        "output_preview": { "type": "string" }
      },
      "additionalProperties": false
    },

    "SubagentComplete": {
      "type": "object",
      "required": ["type", "task_id", "name"],
      "properties": {
        "type": { "const": "subagent_complete" },
        "task_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "result": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Notify": {
      "type": "object",
      "required": ["type", "title", "body"],
      "properties": {
        "type": { "const": "notify" },
        "title": { "type": "string" },
        "body": { "type": "string" }
      },
      "additionalProperties": false
    },

    "OpenUrl": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "open_url" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },

    "OpenFile": {
      "type": "object",
      "required": ["type", "filepath"],
      "properties": {
        "type": { "const": "open_file" },
        "filepath": { "type": "string" }
      },
      "additionalProperties": false
    },

    "BrokerStatus": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "broker_status" },
        "devices": { "type": "array", "items": { "type": "string" } },
        "bound_device_id": { "type": "string" },
        "connected": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "BindResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "bind_result" },
        "bound_device_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "BrokerError": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "broker_error" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ErrorMessage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Ping": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "ping" }
      },
      "additionalProperties": false
    },

    "VaultGetPrompt": {
      "description": "Backend asks the client to retrieve a secret from the Stronghold vault",
      "type": "object",
      "required": ["type", "request_id", "key", "reason"],
      "properties": {
        "type": { "const": "vault_get_prompt" },
        "request_id": { "type": "string" },
        "key": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },

    "VaultGetResponse": {
      "description": "Client responds with the vault secret. value=null + no error means key not found. error set means vault access failed.",
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "const": "vault_get_response" },
        "request_id": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "ShellSessionInput": {
      "type": "object",
      "required": ["type", "session_id", "chars"],
      "properties": {
        "type": { "const": "shell_session_input" },
        "session_id": { "type": "string" },
        "chars": { "type": "string" }
      },
      "additionalProperties": false
    },

    "McpInstallPermissionResponse": {
      "type": "object",
      "required": ["type", "approved", "server_name"],
      "properties": {
        "type": { "const": "mcp_install_permission_response" },
        "approved": { "type": "boolean" },
        "server_name": { "type": "string" },
        "remember": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "ClipboardResponse": {
      "type": "object",
      "required": ["type", "request_id", "ok"],
      "properties": {
        "type": { "const": "clipboard_response" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "text": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "NotificationResponse": {
      "type": "object",
      "required": ["type", "request_id", "ok"],
      "properties": {
        "type": { "const": "notification_response" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ScreenshotResponse": {
      "type": "object",
      "required": ["type", "request_id", "ok"],
      "properties": {
        "type": { "const": "screenshot_response" },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "path": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "SetVoiceResult": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "set_voice_result" },
        "ok": { "type": "boolean" },
        "voice": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "TtsAudio": {
      "description": "Text-to-speech audio metadata. Actual audio chunks may be sent as binary frames with MLTTS001 magic header.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "tts_audio" },
        "streaming": { "type": "boolean" },
        "phase": { "type": "string", "enum": ["start", "chunk", "end"] },
        "stream_id": { "type": "string" },
        "mime_type": { "type": "string" }
      },
      "additionalProperties": true
    },

    "ConfirmationResolved": {
      "type": "object",
      "required": ["type", "confirmation_id"],
      "properties": {
        "type": { "const": "confirmation_resolved" },
        "confirmation_id": { "type": "string" },
        "resolution": { "type": "string" },
        "confirmed": { "type": "boolean" },
        "remember": { "type": "boolean" },
        "always_allow": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "ModelSuggestion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "model_suggestion" },
        "suggested_model": { "type": "string" },
        "cost_ratio": { "type": "string" },
        "context_tokens": { "type": "string" },
        "suggestion_reason": { "type": "string" },
        "model_used": { "type": "string" },
        "rate_limited": { "type": "boolean" },
        "hourly_spend": { "type": "string" },
        "hourly_limit": { "type": "string" }
      },
      "additionalProperties": false
    },

    "McpServerStatus": {
      "type": "object",
      "required": ["type", "server_name", "status"],
      "properties": {
        "type": { "const": "mcp_server_status" },
        "server_name": { "type": "string" },
        "status": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },

    "McpInstallPermission": {
      "type": "object",
      "required": ["type", "server_name"],
      "properties": {
        "type": { "const": "mcp_install_permission" },
        "server_name": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ClipboardRequest": {
      "type": "object",
      "required": ["type", "request_id", "action"],
      "properties": {
        "type": { "const": "clipboard_request" },
        "request_id": { "type": "string" },
        "action": { "type": "string", "enum": ["read", "write"] },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },

    "NotificationRequest": {
      "type": "object",
      "required": ["type", "request_id", "title", "message"],
      "properties": {
        "type": { "const": "notification_request" },
